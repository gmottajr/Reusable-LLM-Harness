<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>LlmHarness.Api</RootNamespace>
    <UserSecretsId>llm-harness-api-development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LlmHarness.Core\LlmHarness.Core.csproj" />
    <ProjectReference Include="..\LlmHarness.ManagedModels\LlmHarness.ManagedModels.csproj" />
    <ProjectReference Include="..\LlmHarness.Providers.Local\LlmHarness.Providers.Local.csproj" />
    <ProjectReference Include="..\LlmHarness.Providers.OpenAI\LlmHarness.Providers.OpenAI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Properties\launchSettings.json">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
